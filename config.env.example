# The Todoist API token is read from macOS Keychain by default.
# Store it with (note the trailing -w with no value: that makes `security`
# prompt for the token instead of taking it on the command line, where it
# would be visible to other processes running as you):
#   security add-generic-password -s todoist-sync -a default -U -w
# Only set it here for non-macOS development environments.
# TODOIST_API_KEY="YOUR_API_KEY_HERE"

# Name of the dedicated list (Reminders) / project (Todoist) to sync.
# Created automatically on both sides if it doesn't already exist.
SYNC_LIST_NAME="Siri Sync"

# Optional: pair containers that are named differently. Each overrides
# SYNC_LIST_NAME for its own side. A project named here must already exist
# in Todoist — it is never auto-created.
# SYNC_REMINDERS_LIST="Chores"
# SYNC_TODOIST_PROJECT="Family Project"

# Which side wins when a completion, due date, title, or notes change on
# both sides differently between two syncs. Must be "reminders" or
# "todoist".
SYNC_CONFLICT_WINNER="reminders"

# Once a pair has been completed on both sides for this many days, it's
# moved out of active reconciliation and into the archive (still matched
# by id if reactivated, but no longer polled every run).
SYNC_ARCHIVE_AFTER_DAYS="180"

# Once a pair's reminder or task has been confirmed missing (deleted, or
# moved out of the synced list/project) for this many consecutive sync
# runs, its counterpart on the other side is deleted too and the pair is
# dropped from state.json. A check count, not elapsed
# time, so it demands that many independent confirmations regardless of
# gaps between runs (e.g. the Mac sleeping) — at prod's 5-minute sync
# interval, 4 checks is about 20 minutes.
SYNC_PRUNE_MISSING_AFTER_CHECKS="4"

# Log verbosity: DEBUG, INFO, WARNING, or ERROR. INFO (default) is just the
# "starting" line plus a one-line-per-run summary. DEBUG adds per-query/
# per-pair detail (every Reminders/Todoist call, conflict resolutions,
# individual archive/prune actions) — meant to be turned on temporarily
# while troubleshooting, not left on permanently.
SYNC_LOG_LEVEL="INFO"
