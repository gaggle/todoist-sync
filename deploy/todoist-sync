#!/bin/bash
# __PROJECT_ROOT__ is substituted by install.sh when this is copied into
# the todoist-sync.app bundle — its location relative to the project root
# changes based on nesting depth, so a baked-in absolute path is more
# robust than BASH_SOURCE-relative traversal.
exec "__PROJECT_ROOT__/.venv/bin/python" -m todoist_sync.sync_tasks
